{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speak_event.py prompt",
            "timeout": 10,
            "statusMessage": "JARVIS: prompt received"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speak_event.py stop",
            "timeout": 10,
            "statusMessage": "JARVIS: response complete"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speak_event.py permission",
            "timeout": 10,
            "statusMessage": "JARVIS: permission requested"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speak_event.py pre_compact",
            "timeout": 10,
            "statusMessage": "JARVIS: compacting context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speak_event.py post_compact",
            "timeout": 10,
            "statusMessage": "JARVIS: context restored"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speak_event.py subagent_start",
            "timeout": 10,
            "statusMessage": "JARVIS: subagent started"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/speak_event.py subagent_stop",
            "timeout": 10,
            "statusMessage": "JARVIS: subagent stopped"
          }
        ]
      }
    ]
  }
}
